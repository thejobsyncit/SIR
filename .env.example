# ==============================================================================
# Revival International — Production & Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your hosting environment and provide real values.
# NEVER commit real passwords, tokens, or private secrets to version control.

# --- SERVER & RUNTIME CONFIGURATION ---
NODE_ENV=production
PORT=5000

# Base URL for frontend clients and CORS allowlist (comma-separated if multiple)
FRONTEND_URL=https://www.revivalinternational.com
ALLOWED_ORIGINS=https://www.revivalinternational.com,https://revivalinternational.com

# --- DATABASE PERSISTENCE (SOLE PRIMARY DATABASE: SUPABASE CLOUD POSTGRESQL) ---
DATABASE_TYPE=supabase
# SQLite is completely disabled and removed. All tables and queries run on Supabase Cloud.

# --- SMTP EMAIL & 2FA NOTIFICATIONS & APPLY VIA EMAIL ---
# Official corporate email address: enquiry@therevivalinternational.com
# Use an account-specific 16-character App Password (not your primary password).
SMTP_EMAIL=enquiry@therevivalinternational.com
SMTP_FROM=enquiry@therevivalinternational.com
SMTP_APP_PASSWORD=your-16-digit-gmail-app-password
GMAIL_APP_PASSWORD=your-16-digit-gmail-app-password

# --- OPTIONAL: ANTHROPIC CLAUDE API KEY (AI ROLE-TAILORED APPLICATION EMAIL) ---
# If provided, the middle paragraph of the job application email is generated dynamically
# with Claude Sonnet 4.6 based on the job description and candidate profile (max 80 words).
# If unset or call fails, gracefully falls back to the deterministic role-category template map.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- SUPABASE CONFIGURATION (OPTIONAL / IF ENABLED) ---
# Public client variables (safe to be bundled in frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Private server secret key (SERVER ONLY - NEVER PREFIX WITH VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key-here

# --- VITE FRONTEND API CONFIGURATION (OPTIONAL) ---
# If frontend is hosted on a separate domain from the Express API, set the backend API URL.
# If frontend and backend are served from the same domain, leave empty to use relative /api.
# VITE_API_BASE_URL=https://api.revivalinternational.com

# --- GOOGLE OAUTH & IDENTITY SERVICES (GIS) ---
# Create an OAuth 2.0 Web Client ID in Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Authorized JavaScript Origins:
#   http://localhost:3000
#   http://localhost:5173
#   https://www.therevivalinternational.com
#   https://therevivalinternational.com
# Authorized Redirect URIs:
#   http://localhost:3000
#   http://localhost:5173
#   https://www.therevivalinternational.com
#   https://therevivalinternational.com
# Scopes: openid, email, profile
VITE_GOOGLE_CLIENT_ID=667233488295-vi442pug1eqttt418c8sbfnksbf3qc20.apps.googleusercontent.com
GOOGLE_CLIENT_ID=667233488295-vi442pug1eqttt418c8sbfnksbf3qc20.apps.googleusercontent.com

# --- DIGITAL ANALYTICS & CONVERSION TRACKING (PHASE 9) ---
# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
# Enter your GA4 Web Stream Measurement ID. Analytics scripts are strictly gated behind cookie consent.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID (Optional, Format: GTM-XXXXXXX)
VITE_GTM_ID=
