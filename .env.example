# ==============================================================================
# Revival International — Production & Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your hosting environment and provide real values.
# NEVER commit real passwords, tokens, or private secrets to version control.

# --- SERVER & RUNTIME CONFIGURATION ---
NODE_ENV=production
PORT=5000

# Base URL for frontend clients and CORS allowlist (comma-separated if multiple)
FRONTEND_URL=https://www.revivalinternational.com
ALLOWED_ORIGINS=https://www.revivalinternational.com,https://revivalinternational.com

# --- DATABASE PERSISTENCE ---
# Path to SQLite database file. On persistent volume mounts (e.g. Render, Docker, VPS),
# specify the full mount path (e.g., /var/data/sir_recruitment.db).
# Defaults to server/sir_recruitment.db if left unset.
DATABASE_PATH=server/sir_recruitment.db

# --- SMTP EMAIL & 2FA NOTIFICATIONS ---
# Official corporate Gmail / Google Workspace or SMTP credentials for sending CRM 2FA codes.
# For Gmail, use an account-specific 16-character App Password (not your primary password).
SMTP_EMAIL=notifications@revivalinternational.com
SMTP_APP_PASSWORD=your-16-digit-app-password

# --- SUPABASE CONFIGURATION (OPTIONAL / IF ENABLED) ---
# Public client variables (safe to be bundled in frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Private server secret key (SERVER ONLY - NEVER PREFIX WITH VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key-here

# --- VITE FRONTEND API CONFIGURATION (OPTIONAL) ---
# If frontend is hosted on a separate domain from the Express API, set the backend API URL.
# If frontend and backend are served from the same domain, leave empty to use relative /api.
# VITE_API_BASE_URL=https://api.revivalinternational.com

# --- DIGITAL ANALYTICS & CONVERSION TRACKING (PHASE 9) ---
# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
# Enter your GA4 Web Stream Measurement ID. Analytics scripts are strictly gated behind cookie consent.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID (Optional, Format: GTM-XXXXXXX)
VITE_GTM_ID=
